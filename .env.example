# Postgres connection string. With the included docker-compose.yml, the default below just works.
DATABASE_URL="postgresql://capsule:capsule@localhost:5432/timecapsule"

# Optional: a shared secret to protect the /api/cron/deliver-due endpoint when you deploy this
# somewhere and point a real scheduler (Vercel Cron, GitHub Actions, etc.) at it.
CRON_SECRET="dev-secret-change-me"

# Required: secret used to sign magic-link session cookies on /my-letters. Generate with
# `openssl rand -hex 32`. Changing this invalidates every existing session.
SESSION_SECRET="dev-secret-change-me"

# Required for /admin (abuse review — view/unblock rate-limit offenders). Sent as
# "Authorization: Bearer <ADMIN_SECRET>". Generate with `openssl rand -hex 24`.
ADMIN_SECRET="dev-secret-change-me"

# --- Real email delivery (via Resend: https://resend.com/api-keys) ---
# Leave RESEND_API_KEY unset/empty to keep mock mode (console log, no real send).
# Fill both in to send real email — EMAIL_FROM must be on a domain you've verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Time Capsule <letters@yourdomain.com>"

# --- Guided-writing agent (via the Gemini API: https://aistudio.google.com/apikey) ---
# Leave unset to hide the "Not sure what to write?" toggle entirely — the rest of the app is unaffected.
GEMINI_API_KEY=""

# --- Media attachments (Vercel Blob) ---
# Provision with `vercel blob create-store <name> --access public` (auto-links to the project and
# writes this to .env.local for local dev via `vercel env pull`). Required for photo/audio/video
# uploads to work; the rest of the app runs fine without it.
BLOB_READ_WRITE_TOKEN=""
